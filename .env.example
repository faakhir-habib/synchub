# Copy to .env (local dev, apps/hub-api/.env) and adjust as needed.
# In Docker, these are set directly in docker-compose.yml instead.

# Port the hub-api HTTP server listens on.
PORT=8080

# Prisma SQLite connection string (must be an absolute "file:" path in Docker
# so it lands on the persisted volume).
#   Local dev: file:./apps/hub-api/prisma/dev.db
#   Docker:    file:/data/synchub.db
DATABASE_URL="file:./apps/hub-api/prisma/dev.db"

# Directory where the sync relay store keeps its on-disk state.
#   Local dev: apps/hub-api/data/relay-store
#   Docker:    /data/relay-store
RELAY_STORE_DIR="apps/hub-api/data/relay-store"

# Optional override for the directory hub-api serves the built SPA from.
# Defaults to apps/hub-web/dist relative to the compiled hub-api output; the
# Docker image sets this explicitly since it flattens the runtime layout.
# WEB_DIST_DIR=
