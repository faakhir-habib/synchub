# Copy to .env (local dev, apps/hub-api/.env) and adjust as needed.
# In Docker, these are set directly in docker-compose.yml instead.

# Port the hub-api HTTP server listens on.
PORT=8080

# Prisma SQLite connection string. Prisma resolves relative "file:" paths
# relative to schema.prisma's own directory (apps/hub-api/prisma/), NOT the
# process cwd -- so the local-dev value here is relative to that folder.
# Docker needs an absolute path so it lands on the persisted volume.
#   Local dev: file:./dev.db          (-> apps/hub-api/prisma/dev.db)
#   Docker:    file:/data/synchub.db
DATABASE_URL="file:./dev.db"

# Directory where the sync relay store keeps its on-disk state. Resolved
# relative to the process cwd (apps/hub-api, when run via
# `pnpm --filter hub-api dev`), unlike DATABASE_URL above.
#   Local dev: data/relay-store       (-> apps/hub-api/data/relay-store)
#   Docker:    /data/relay-store
RELAY_STORE_DIR="data/relay-store"

# Optional override for the directory hub-api serves the built SPA from.
# Defaults to apps/hub-web/dist relative to the compiled hub-api output; the
# Docker image sets this explicitly since it flattens the runtime layout.
# WEB_DIST_DIR=
