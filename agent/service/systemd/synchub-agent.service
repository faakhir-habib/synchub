[Unit]
Description=SyncHub Agent (Claude Code transcript sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to your install.
ExecStart=/usr/bin/node /opt/synchub/agent/src/cli.js run
Restart=on-failure
RestartSec=5
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
# Config is read from ~/.synchub/config.json for this user by default.

[Install]
WantedBy=default.target
