{
  "name": "synchub",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Hub + headless Agents that keep Claude Code session transcripts in sync across machines",
  "license": "MIT",
  "author": "Faakhir Habib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faakhir-habib/synchub.git"
  },
  "homepage": "https://github.com/faakhir-habib/synchub#readme",
  "bugs": {
    "url": "https://github.com/faakhir-habib/synchub/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --filter @synchub/shared build && pnpm --parallel --filter ./apps/hub-api --filter ./apps/hub-web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
